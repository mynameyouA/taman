# ==========================================
# CẤU HÌNH HỆ THỐNG TÂM AN AI & FREE LLM ROUTER
# ==========================================

# 1. Cơ sở dữ liệu (tùy chọn)
DATABASE_URL=

# 2. Google Gemini API (Ưu tiên 1 - Free Tier 15 RPM tại Google AI Studio)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 3. Groq Cloud (Ưu tiên 2 - Free Tier 30 RPM, 14,400 requests/ngày không cần thẻ)
# Lấy miễn phí tại: https://console.groq.com/keys
# Hỗ trợ Llama-3.3-70b-versatile, Mixtral 8x7b với tốc độ cực nhanh ~300 token/giây
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. OpenRouter Free Models (Ưu tiên 3 - Hàng chục model :free vĩnh viễn)
# Lấy miễn phí tại: https://openrouter.ai/keys
# Các model miễn phí: meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free, qwen/qwen-2.5-72b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 5. FreeLLM Local Proxy (Ưu tiên 4 - Nếu khởi chạy repo freellmapi tại máy cục bộ)
# Repo: https://github.com/tashfeenahmed/freellmapi
# FREELLM_PROXY_URL=http://127.0.0.1:3001/v1

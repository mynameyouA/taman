generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ==========================================
// 1. NGƯỜI DÙNG & THANH TOÁN (TENANT & MONETIZATION)
// ==========================================
enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String?
  avatar_url         String?
  role               Role      @default(USER)
  
  // Monetization & Subscription (Stripe)
  stripe_customer_id String?   @unique
  plan               Plan      @default(FREE)
  credits_balance    Int       @default(1000) // Hệ thống Token/Credit cho Voice & 3D
  subscription_end   DateTime?

  // Quan hệ
  sessions           ChatSession[]
  feedbacks          FeedbackEvent[]
  usage_logs         UsageLog[]

  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
}

// Bảng log tiêu thụ token (LLM, TTS API)
model UsageLog {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  action_type String   // e.g., "TEXT_CHAT", "VOICE_CHAT", "IMAGE_GEN"
  cost        Int      // Số credit bị trừ
  created_at  DateTime @default(now())
}

// ==========================================
// 2. ADMIN LEARNING STUDIO (KNOWLEDGE BASE)
// ==========================================
enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id               String           @id @default(uuid())
  title            String
  file_url         String?
  file_type        String           // pdf, txt, markdown
  status           ProcessingStatus @default(PENDING)
  total_chunks     Int              @default(0)
  processed_chunks Int              @default(0)
  error_log        String?
  
  chunks           KnowledgeItem[]
  
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
}

model KnowledgeItem {
  id               String    @id @default(uuid())
  document_id      String?
  document         Document? @relation(fields: [document_id], references: [id], onDelete: SetNull)
  
  type             String    // document_chunk, manual_concept, method
  title            String?
  content          String
  
  // Vector 1536 chiều từ text-embedding-3-small
  embedding        Unsupported("vector(1536)")? 
  
  tags             String[]
  topics           String[]
  is_active        Boolean   @default(true)
  quality_score    Float     @default(0)
  usage_count      Int       @default(0)
  
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

}

model GoldenExample {
  id               String    @id @default(uuid())
  situation_context String?
  user_query       String
  ideal_response   String
  
  // Vector của câu hỏi để lấy few-shot
  embedding        Unsupported("vector(1536)")?
  
  admin_notes      String?
  quality_rating   Float     @default(5.0)
  is_active        Boolean   @default(true)
  
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

}

// ==========================================
// 3. 3D CHAT & TƯƠNG TÁC NGƯỜI DÙNG
// ==========================================
model ChatSession {
  id          String        @id @default(uuid())
  user_id     String
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title       String?
  type        String        @default("feng_shui") // feng_shui, tarot, dream, meditation
  
  messages    ChatMessage[]
  
  started_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
}

model ChatMessage {
  id               String    @id @default(uuid())
  session_id       String
  session          ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  
  role             String    // user, assistant, system
  content          String
  
  // Dữ liệu phục vụ 3D Avatar
  audio_url        String?   // Link file audio hoặc buffer cache
  visemes_url      String?   // Link URL S3 chứa timing nhép môi (Visemes)
  latency_ms       Int?      // Đo lường độ trễ thực tế

  // Feedback từ user
  feedbacks        FeedbackEvent[]

  created_at       DateTime  @default(now())
}

model FeedbackEvent {
  id               String      @id @default(uuid())
  message_id       String
  message          ChatMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user_id          String
  user             User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  is_helpful       Boolean
  feedback_text    String?
  admin_reviewed   Boolean     @default(false)
  
  created_at       DateTime    @default(now())
}

// ==========================================
// 4. BÁO CÁO & QUẢN TRỊ (ANALYTICS)
// ==========================================
model LearningReport {
  id                    String   @id @default(uuid())
  period_start          DateTime
  period_end            DateTime
  total_conversations   Int
  total_feedback_events Int
  avg_latency           Float?
  top_topics            String[]
  suggested_actions     String[]
  
  created_at            DateTime @default(now())
}
